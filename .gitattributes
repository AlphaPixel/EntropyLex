# Keep repository text stable across Windows, macOS, and Linux checkouts.
* text=auto eol=lf

# Native Windows command scripts use Windows line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# These files are executed by Unix-compatible tools, including in CI.
*.sh text eol=lf
Makefile text eol=lf
*.mk text eol=lf

# Dictionary artifacts and their hashed fixture inputs require stable bytes.
*.lxj text eol=lf
data/dict/*.json text eol=lf
tests/fixtures/dict/*.json text eol=lf
tests/fixtures/dict/*.txt text eol=lf
tests/vectors/*.json text eol=lf
