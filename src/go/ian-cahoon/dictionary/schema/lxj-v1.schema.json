{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EntropyLex JSON dictionary (LXJ) version 1",
  "description": "The structural rules for an LXJ v1 dictionary. FORMAT.md defines additional checks that JSON Schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "dictionary",
    "profile",
    "recognition",
    "indexing",
    "tokens",
    "fingerprint",
    "provenance"
  ],
  "properties": {
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "LXJ" },
        "version": { "const": 1 }
      }
    },
    "dictionary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "purpose", "name", "language", "script"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "purpose": { "enum": ["production", "test"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35,
          "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})*$"
        },
        "script": { "type": "string", "pattern": "^[A-Z][a-z]{3}$" }
      }
    },
    "profile": {
      "oneOf": [
        { "$ref": "#/$defs/profile_el8" },
        { "$ref": "#/$defs/profile_el12" },
        { "$ref": "#/$defs/profile_el14" },
        { "$ref": "#/$defs/profile_el16" }
      ]
    },
    "recognition": { "$ref": "#/$defs/recognition" },
    "indexing": { "const": "continuous-v1" },
    "tokens": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipe", "sha256"],
      "properties": {
        "recipe": { "const": "LXFP-1" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "selection"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/source" }
        },
        "selection": { "$ref": "#/$defs/selection" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "properties": { "name": { "const": "EL-8" } },
            "required": ["name"]
          }
        }
      },
      "then": { "properties": { "tokens": { "minItems": 256, "maxItems": 256 } } }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "properties": { "name": { "const": "EL-12" } },
            "required": ["name"]
          }
        }
      },
      "then": { "properties": { "tokens": { "minItems": 4368, "maxItems": 4368 } } }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "properties": { "name": { "const": "EL-14" } },
            "required": ["name"]
          }
        }
      },
      "then": { "properties": { "tokens": { "minItems": 21844, "maxItems": 21844 } } }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "properties": { "name": { "const": "EL-16" } },
            "required": ["name"]
          }
        }
      },
      "then": { "properties": { "tokens": { "minItems": 65792, "maxItems": 65792 } } }
    }
  ],
  "$defs": {
    "profile_common": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "normal_bits",
        "remainder_bits",
        "normal_count",
        "trim_count",
        "total_count"
      ],
      "properties": {
        "name": { "type": "string" },
        "normal_bits": { "type": "integer" },
        "remainder_bits": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "normal_count": { "type": "integer" },
        "trim_count": { "type": "integer" },
        "total_count": { "type": "integer" }
      }
    },
    "profile_el8": {
      "allOf": [
        { "$ref": "#/$defs/profile_common" },
        {
          "properties": {
            "name": { "const": "EL-8" },
            "normal_bits": { "const": 8 },
            "remainder_bits": { "const": [] },
            "normal_count": { "const": 256 },
            "trim_count": { "const": 0 },
            "total_count": { "const": 256 }
          }
        }
      ]
    },
    "profile_el12": {
      "allOf": [
        { "$ref": "#/$defs/profile_common" },
        {
          "properties": {
            "name": { "const": "EL-12" },
            "normal_bits": { "const": 12 },
            "remainder_bits": { "const": [4, 8] },
            "normal_count": { "const": 4096 },
            "trim_count": { "const": 272 },
            "total_count": { "const": 4368 }
          }
        }
      ]
    },
    "profile_el14": {
      "allOf": [
        { "$ref": "#/$defs/profile_common" },
        {
          "properties": {
            "name": { "const": "EL-14" },
            "normal_bits": { "const": 14 },
            "remainder_bits": { "const": [2, 4, 6, 8, 10, 12] },
            "normal_count": { "const": 16384 },
            "trim_count": { "const": 5460 },
            "total_count": { "const": 21844 }
          }
        }
      ]
    },
    "profile_el16": {
      "allOf": [
        { "$ref": "#/$defs/profile_common" },
        {
          "properties": {
            "name": { "const": "EL-16" },
            "normal_bits": { "const": 16 },
            "remainder_bits": { "const": [8] },
            "normal_count": { "const": 65536 },
            "trim_count": { "const": 256 },
            "total_count": { "const": 65792 }
          }
        }
      ]
    },
    "recognition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unicode_version", "normalization", "case", "token_text", "tokenization"],
      "properties": {
        "unicode_version": { "const": "15.1.0" },
        "normalization": { "const": "NFC" },
        "case": { "enum": ["none", "ascii-lower"] },
        "token_text": { "const": "unicode-scalars" },
        "tokenization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "canonical_separator", "separators"],
          "properties": {
            "kind": { "const": "separator-runs" },
            "canonical_separator": { "const": "U+0020" },
            "separators": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(?:U\\+[0-9A-F]{4}|U\\+[1-9A-F][0-9A-F]{4,5})$"
              }
            }
          }
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "role", "location", "license", "sha256", "record_count"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "role": { "type": "string", "minLength": 1, "maxLength": 256 },
        "location": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "license": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "record_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "settings_location", "settings_sha256"],
      "properties": {
        "method": { "type": "string", "minLength": 1, "maxLength": 128 },
        "settings_location": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "settings_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
